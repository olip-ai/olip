{
  "name": "olip-site",
  "version": "0.2.0-draft",
  "private": true,
  "description": "Source of https://olip.ai, the documentation site for OLIP (Open Legal Intake Protocol): OLIP 0.1 draft plus the optional 0.2 additions.",
  "scripts": {
    "sync-spec": "node scripts/sync-spec.mjs",
    "start": "npm run sync-spec && docusaurus start",
    "build": "npm run sync-spec && docusaurus build && node scripts/postbuild.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "test": "node scripts/run-tests.mjs",
    "check:built": "node scripts/check-built.mjs",
    "scan": "node scripts/scan-publication.mjs ."
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mdx-js/react": "3.1.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "axe-core": "4.10.3"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
