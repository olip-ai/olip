                  "evidence"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "acknowledged",
                      "responded",
                      "declined",
                      "consultation_requested",
                      "consultation_confirmed",
                      "completed",
                      "cancelled"
                    ]
                  },
                  "actor": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "human",
                          "automated"
                        ]
                      },
                      "role": {
                        "type": "string"
                      }
                    }
                  },
                  "evidence": {
                    "type": "object",
                    "required": [
                      "type",
                      "ref"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "olip_version",
                    "handoff"
                  ],
                  "properties": {
                    "olip_version": {
                      "type": "string"
                    },
                    "handoff": {
                      "$ref": "../schemas/handoff.json"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "OLIP error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          }
        }
      }
    }
  }
}