{
  "openapi": "3.1.0",
  "info": {
    "title": "OLIP 0.1 (working draft)",
    "version": "0.1.0-draft",
    "description": "Open Legal Intake Protocol HTTPS binding. DRAFT, not adopted. See https://olip.ai/spec/0.1/ (spec/OLIP-0.1-DRAFT.md).",
    "license": {
      "name": "Proposed: CC BY 4.0 for spec text, Apache-2.0 for code (pending legal review)",
      "identifier": "CC-BY-4.0"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Reference mock server (fictional data)"
    }
  ],
  "components": {
    "securitySchemes": {
      "olipClient": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {
              "olip.read": "read",
              "olip.write": "write",
              "olip.recipient": "recipient events"
            }
          }
        }
      }
    },
    "parameters": {
      "OlipVersion": {
        "name": "OLIP-Version",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "example": "0.1"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        }
      }
    }
  },
  "paths": {
