{
  "schema": "status-machine",
  "fictional": true,
  "description": "The canonical status machine.",
  "example": {
    "olip_version": "0.1",
    "description": "Canonical OLIP handoff status machine. Normative. A state may change only through a transition listed here, from an allowed source, carrying the listed evidence. Nothing may be inferred from another state.",
    "sources": {
      "user": "The consumer, proven by an out-of-band approval the calling agent cannot produce on its own.",
      "client": "The authenticated calling agent platform acting for the user.",
      "host": "The OLIP endpoint that stores the handoff.",
      "transport": "A delivery channel (for example email or a webhook) that reports acceptance or failure.",
      "recipient_system": "The recipient law firm's intake system, proven by a signature or an authenticated call.",
      "recipient_human": "A person at the recipient firm, recorded by the recipient system with an authenticated call."
    },
    "states": {
      "draft": {
        "terminal": false,
        "meaning": "Preview exists. Nothing approved, nothing transmitted."
      },
      "approved": {
        "terminal": false,
        "meaning": "The user approved this exact recipient, fields, purpose and notice version. Nothing transmitted yet."
      },
      "recorded": {
        "terminal": false,
        "meaning": "Stored by the host and held (for example waiting for a policy gate). Not scheduled, not transmitted."
      },
      "queued": {
        "terminal": false,
        "meaning": "Scheduled for transmission. One or more attempts may have failed. Not yet accepted by any channel."
      },
      "sent": {
        "terminal": false,
        "meaning": "A transport accepted the message. No proof it reached the recipient's system."
      },
      "delivered": {
        "terminal": false,
        "meaning": "The recipient's intake system stored it and returned a verifiable receipt. No proof any person read it."
      },
      "acknowledged": {
        "terminal": false,
        "meaning": "A person at the recipient firm recorded that they viewed it. Automatic replies never count. Not acceptance of the matter."
      },
      "responded": {
        "terminal": false,
        "meaning": "A person at the recipient firm sent a substantive reply. Not acceptance of the matter."
      },
      "declined": {
        "terminal": true,
        "meaning": "The recipient said it will not take the matter."
      },
      "consultation_requested": {
        "terminal": false,
        "meaning": "A consultation was proposed. Not yet agreed."
      },
      "consultation_confirmed": {
        "terminal": false,
        "meaning": "The recipient confirmed a consultation time. Not an attorney-client relationship."
      },
      "completed": {
        "terminal": true,
        "meaning": "The recipient recorded that the consultation took place. Says nothing about engagement or outcome."
      },
      "cancelled": {
        "terminal": true,
        "meaning": "The user withdrew. If anything was already transmitted the recipient may keep a copy; see cancellation.effect."
      },
      "failed": {
        "terminal": true,
        "meaning": "Transmission could not be completed after the allowed attempts."
      },
      "expired": {
        "terminal": true,
        "meaning": "The approval or hold window ended before transmission."
      }
    },
    "transitions": [
      {
        "from": "draft",
        "to": "approved",
        "sources": [
          "user"
        ],
        "evidence": [
          "user_approval"
        ]
      },
      {
        "from": "draft",
        "to": "expired",
        "sources": [
          "host"
        ],
        "evidence": [
          "ttl_elapsed"
        ]
      },
      {
        "from": "draft",
        "to": "cancelled",
        "sources": [
          "client",
          "user"
        ],
        "evidence": [
          "cancel_request"
        ]
      },
      {
        "from": "approved",
        "to": "expired",
        "sources": [
          "host"
        ],
        "evidence": [
          "ttl_elapsed"
        ]
      },
      {
        "from": "approved",
        "to": "cancelled",
        "sources": [
          "client",
          "user"
        ],
        "evidence": [
          "cancel_request"
        ]
      },
      {
        "from": "approved",
        "to": "recorded",
        "sources": [
          "host"
        ],
        "evidence": [
          "host_storage"
        ]
      },
      {
        "from": "approved",
        "to": "queued",
        "sources": [
          "host"
        ],
        "evidence": [
          "host_storage"
        ]
      },
      {
        "from": "approved",
        "to": "delivered",
        "sources": [
          "recipient_system"
        ],
        "evidence": [
          "recipient_receipt"
        ]
      },
      {
        "from": "recorded",
        "to": "queued",
        "sources": [
          "host"
        ],
        "evidence": [
          "hold_released"
        ]
      },
      {
        "from": "recorded",
        "to": "cancelled",
        "sources": [
          "client",
          "user"
        ],
        "evidence": [
          "cancel_request"
        ]
      },
      {
        "from": "recorded",
        "to": "expired",
        "sources": [
          "host"
        ],
        "evidence": [
          "ttl_elapsed"
        ]
      },
      {
        "from": "queued",
        "to": "sent",
        "sources": [
          "transport"
        ],
        "evidence": [
          "transport_acceptance"
        ]
      },
      {
        "from": "queued",
