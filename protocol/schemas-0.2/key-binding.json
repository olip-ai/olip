{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/0.2/schemas/key-binding.json",
  "title": "OLIP key binding (0.2)",
  "description": "A signed statement that a signing key belongs to the intake system of one named professional or firm, with the evidence behind that statement. Clients use it to decide whether a receipt or recipient event was signed by the recipient they chose, not merely by some key.",
  "type": "object",
  "required": [
    "olip_version",
    "binding_id",
    "subject",
    "key",
    "evidence",
    "valid_from",
    "valid_until",
    "status",
    "issuer",
    "issued_at",
    "signature"
  ],
  "properties": {
    "olip_version": {
      "const": "0.2"
    },
    "binding_id": {
      "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/id"
    },
    "subject": {
      "type": "object",
      "required": [
        "professional_ids"
      ],
      "properties": {
        "professional_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/id"
          }
        },
        "firm_id": {
          "oneOf": [
            {
              "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string",
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "required": [
        "kty",
        "crv",
        "x",
        "kid"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "alg": {
          "const": "EdDSA"
        },
        "use": {
          "const": "sig"
        }
      },
      "description": "The bound public key (JWK). Its kid is the kid that appears in receipts and recipient events."
    },
    "purposes": {
      "type": "array",
      "items": {
        "enum": [
          "receipt",
          "recipient_event",
          "intake_card"
        ]
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "method",
        "checked_at",
        "statement"
      ],
      "properties": {
        "method": {
          "enum": [
            "firm_domain_wellknown",
            "licensing_authority_record",
            "host_attestation"
          ],
          "description": "firm_domain_wellknown: the key is served at /.well-known/olip-keys.json on a domain that the licensing record lists for the professional. licensing_authority_record: the authority's own record names the key. host_attestation: the issuer says it checked, with no public evidence (weakest)."
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/timestamp"
        },
        "evidence_sha256": {
          "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/nullableDigest"
        },
        "statement": {
          "type": "string",
          "maxLength": 600
        }
      },
      "additionalProperties": false
    },
    "valid_from": {
      "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "revoked_at": {
      "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/nullableTimestamp"
    },
    "revocation_reason": {
      "enum": [
        null,
        "key_compromise",
        "superseded",
        "professional_left",
        "issuer_error"
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "issuer": {
      "type": "object",
      "required": [
        "id",
        "kid",
        "keys_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 300
        },
        "kid": {
          "type": "string"
        },
        "keys_url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/timestamp"
    },
    "signature": {
      "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/signature"
    },
    "extensions": {
      "$ref": "https://olip.ai/spec/0.1/schemas/common.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
