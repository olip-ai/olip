{
  "olip_version": "2.0-draft",
  "release_status": "proposed_draft_not_adopted",
  "statement": "OLIP 2.0 is a proposed extension under development. It has not been adopted by any standards body or approved by any bar or regulator. OLIP 1.0 is unchanged.",
  "profiles": [
    "olip-lifecycle-core/2",
    "olip-consultation/2",
    "olip-engagement/2",
    "olip-communications/2",
    "olip-matter/2"
  ],
  "base_path": "/olip/v2",
  "supported_media": [
    "application/json"
  ],
  "extension_id": "olip.ai/lifecycle-capabilities/2.0-draft",
  "implementation": {
    "name": "OLIP 2.0-draft reference lifecycle host",
    "mode": "mock",
    "topology": "relay",
    "operator": {
      "operator_id": "op_test_neutral_relay",
      "display_name": "Neutral Relay Co. (fictional independent vendor)"
    },
    "fictional_data_only": true,
    "sponsor_services_required": false
  },
  "auth": {
    "token_endpoint": "/olip/v2/token",
    "grant_types": [
      "client_credentials",
      "urn:olip:params:oauth:grant-type:delegation_code"
    ],
    "user_sign_in": "/olip/v2/user-sessions (mock)",
    "agent_delegation": "/olip/v2/agent-delegations"
  },
  "user_approval_methods": [
    "hosted_otp_mock"
  ],
  "approval_is_model_callable": true,
  "encryption": {
    "in_transit": "Mock runs on loopback HTTP. A real host must use TLS 1.2 or later (TLS 1.3 preferred).",
    "at_rest": "AES-256-GCM with a host-managed key",
    "end_to_end": false,
    "statement": "Not end-to-end encrypted: the host can decrypt to scan, deliver and export."
  },
