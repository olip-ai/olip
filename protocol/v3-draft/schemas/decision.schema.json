{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/decision.schema.json",
  "title": "Policy decision",
  "description": "OLIP 3.0-draft.1 (proposed draft, not adopted).",
  "type": "object",
  "properties": {
    "olip_version": {
      "const": "3.0-draft.1"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_receipt": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "privileged_admin",
            "firm_authoritative",
            "external_disclosure",
            "authorized_state_change",
            "local_preparation",
            "read_only"
          ]
        },
        "decision": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "effect",
        "decision",
        "policy_version",
        "note"
      ],
      "additionalProperties": false
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "allow",
        "require_user_approval",
        "require_firm_authority",
        "deny",
        "unknown_policy"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_version": {
      "type": "string"
    },
    "detail": {
      "type": "object"
    }
  },
  "required": [
    "olip_version",
    "decision",
    "reason_code",
    "missing",
    "policy_version"
  ],
  "additionalProperties": false
}
