{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/casebrief-check.schema.json",
  "title": "CaseBrief check",
  "description": "OLIP 3.0-draft.1 (proposed draft, not adopted).",
  "type": "object",
  "properties": {
    "olip_version": {
      "const": "3.0-draft.1"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_receipt": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "privileged_admin",
            "firm_authoritative",
            "external_disclosure",
            "authorized_state_change",
            "local_preparation",
            "read_only"
          ]
        },
        "decision": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "effect",
        "decision",
        "policy_version",
        "note"
      ],
      "additionalProperties": false
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "casebrief_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "field_paths": {
      "type": "array"
    },
    "missing_for_screening": {
      "type": "array"
    },
    "sensitive_findings": {
      "type": "object"
    },
    "instruction_like_text": {
      "type": "object"
    },
    "transmitted": {
      "const": false
    },
    "stored": {
      "const": false
    },
    "statement": {
      "type": "string"
    }
  },
  "required": [
    "olip_version",
    "casebrief_digest",
    "transmitted",
    "stored"
  ],
  "additionalProperties": false
}
