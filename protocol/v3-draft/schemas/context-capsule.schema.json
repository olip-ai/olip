    "capsule_version": {
      "const": "3.0-draft.1"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^cap_"
    },
    "matter_ref": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^subj_"
    },
    "controller": {
      "type": "object"
    },
    "issuer": {
      "type": "string"
    },
    "fictional": {
      "type": "boolean"
