{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/lifecycle-result.schema.json",
  "title": "Lifecycle step result",
  "description": "OLIP 3.0-draft.1 (proposed draft, not adopted).",
  "type": "object",
  "properties": {
    "olip_version": {
      "const": "3.0-draft.1"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_receipt": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "privileged_admin",
            "firm_authoritative",
            "external_disclosure",
            "authorized_state_change",
            "local_preparation",
            "read_only"
          ]
        },
        "decision": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "effect",
        "decision",
        "policy_version",
        "note"
      ],
      "additionalProperties": false
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "operation": {
      "type": "string"
    },
    "lifecycle_v2_route": {
      "type": "string"
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "effect": {
      "enum": [
        "privileged_admin",
        "firm_authoritative",
        "external_disclosure",
        "authorized_state_change",
        "local_preparation",
        "read_only"
      ]
    },
    "next": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    }
  },
  "required": [
    "olip_version",
    "operation",
    "lifecycle_v2_route",
    "result",
    "effect"
  ],
  "additionalProperties": false
}
