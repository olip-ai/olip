{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/events-page.schema.json",
  "title": "Workflow events page",
  "description": "OLIP 3.0-draft.1 (proposed draft, not adopted).",
  "type": "object",
  "properties": {
    "olip_version": {
      "const": "3.0-draft.1"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_receipt": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "privileged_admin",
            "firm_authoritative",
            "external_disclosure",
            "authorized_state_change",
            "local_preparation",
            "read_only"
          ]
        },
        "decision": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "effect",
        "decision",
        "policy_version",
        "note"
      ],
      "additionalProperties": false
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "workflow_id": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "https://olip.ai/spec/3.0-draft/schemas/workflow-event.schema.json"
      }
    },
    "next_cursor": {
      "type": "string"
    },
    "has_more": {
      "type": "boolean"
    },
    "head": {
      "type": "object"
    },
    "chain": {
      "type": "object"
    },
    "keys_url": {
      "type": "string"
    }
  },
  "required": [
    "olip_version",
    "workflow_id",
    "entries",
    "next_cursor",
    "has_more",
    "chain"
  ],
  "additionalProperties": false
}
