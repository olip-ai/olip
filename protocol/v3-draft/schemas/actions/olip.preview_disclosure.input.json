{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/actions/olip.preview_disclosure.input.json",
  "title": "Prepare a disclosure for approval (input)",
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The workflow id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The organization id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    },
    "stage": {
      "enum": [
        "screening",
        "casebrief"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
      },
      "description": "Field paths, exactly as the organization's intake questions list them."
    }
  },
  "required": [
    "workflow_id",
    "organization_id",
    "stage",
    "fields"
  ],
  "additionalProperties": false
}
