{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/actions/olip.set_jurisdiction_policy.input.json",
  "title": "Set jurisdiction policy (operator) (input)",
  "type": "object",
  "properties": {
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "status": {
      "enum": [
        "sandbox_only",
        "suspended",
        "pending_counsel_review",
        "approved_by_counsel"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_by": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "jurisdiction",
    "status"
  ],
  "additionalProperties": false
}
