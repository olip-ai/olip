{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/actions/olip.get_recipient_policy.input.json",
  "title": "Get an organization's intake policy (input)",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The organization id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    },
    "stage": {
      "enum": [
        "screening",
        "casebrief"
      ]
    }
  },
  "required": [
    "organization_id"
  ],
  "additionalProperties": false
}
