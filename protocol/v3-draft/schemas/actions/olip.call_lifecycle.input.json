{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/actions/olip.call_lifecycle.input.json",
  "title": "Use a 2.0 lifecycle step (input)",
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The workflow id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    },
    "operation": {
      "enum": [
        "get_conflict_screen",
        "get_consultation",
        "get_engagement",
        "get_thread",
        "get_messages",
        "get_matter_events",
        "request_consultation",
        "propose_consultation_slot",
        "respond_to_engagement_offer",
        "create_thread",
        "send_message",
        "submit_consultation_request",
        "submit_consultation_proposal",
        "send_authorized_message"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The object id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "workflow_id",
    "operation"
  ],
  "additionalProperties": false
}
