{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/actions/olip.submit_approved_disclosure.input.json",
  "title": "Send an approved disclosure (input)",
  "type": "object",
  "properties": {
    "disclosure_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The disclosure id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The grant id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    },
    "grant_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "disclosure_id",
    "grant_id",
    "grant_digest"
  ],
  "additionalProperties": false
}
