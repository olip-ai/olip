{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/actions/olip.import_context_capsule.input.json",
  "title": "Import a context capsule (input)",
  "type": "object",
  "properties": {
    "capsule": {
      "type": "object"
    },
    "import_authorization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The import authorization id returned earlier.",
      "pattern": "^[A-Za-z0-9_:.-]{1,200}$"
    }
  },
  "required": [
    "capsule",
    "import_authorization_id"
  ],
  "additionalProperties": false
}
