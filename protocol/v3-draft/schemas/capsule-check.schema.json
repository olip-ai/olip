{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olip.ai/spec/3.0-draft/schemas/capsule-check.schema.json",
  "title": "Capsule check",
  "description": "OLIP 3.0-draft.1 (proposed draft, not adopted).",
  "type": "object",
  "properties": {
    "olip_version": {
      "const": "3.0-draft.1"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_receipt": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "privileged_admin",
            "firm_authoritative",
            "external_disclosure",
            "authorized_state_change",
            "local_preparation",
            "read_only"
          ]
        },
        "decision": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "effect",
        "decision",
        "policy_version",
        "note"
      ],
      "additionalProperties": false
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "ok": {
      "type": "boolean"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issuer_kid": {
      "type": [
        "string",
        "null"
      ]
    },
    "encrypted": {
      "type": "boolean"
    },
    "stored": {
      "const": false
    }
  },
  "required": [
    "olip_version",
    "ok",
    "problems"
  ],
  "additionalProperties": false
}
